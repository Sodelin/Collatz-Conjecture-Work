"∀ {α C W : Type} (f : α → α) (one : α) (decode : C → α) (rank : C → W) (lt : W → W → Prop)\n  (edge : C → Nat → Nat → C → Prop) (Entry : C → Prop) (Domain : α → Prop),\n  f one = one →\n    (WellFounded fun c' c => lt (rank c') (rank c)) →\n      (∀ (c : C), decode c ≠ one → ∃ a b c', edge c a b c') →\n        (∀ {c : C} {a b : Nat} {c' : C},\n            edge c a b c' →\n              NewMathDiscovery.RankedCoalescence.iterate f a (decode c) =\n                NewMathDiscovery.RankedCoalescence.iterate f b (decode c')) →\n          (∀ {c : C} {a b : Nat} {c' : C}, edge c a b c' → lt (rank c') (rank c)) →\n            (∀ (x : α), Domain x → ∃ c, Entry c ∧ decode c = x) →\n              ∀ (x : α), Domain x → NewMathDiscovery.RankedCoalescence.Reaches f one x"