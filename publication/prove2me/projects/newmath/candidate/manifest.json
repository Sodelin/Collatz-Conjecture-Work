    {
      "key": "thm:NewMathDiscovery.BlindnessRealization.blind_downward",
      "kind": "theorem",
      "depends_on": [
        "def:NewMathDiscovery.BlindnessRealization",
        "thm:NewMathDiscovery.BlindnessRealization.blind_iff_below_generator"
      ],
      "payload_file": "payloads/NewMathDiscovery_BlindnessRealization_blind_downward.theorem.json",
      "solution_file": "Solutions/Sol_NewMathDiscovery_BlindnessRealization_blind_downward.lean",
      "theorem_file": "Theorems/Thm_NewMathDiscovery_BlindnessRealization_blind_downward.lean",
      "metadata_status": "passed",
      "explanation": "Apply the exact realization equivalence to a blind T to obtain a generator containing T. Compose that containment with S⊆T, then apply the reverse realization implication to S."
    },
    {
      "key": "thm:NewMathDiscovery.BlindnessRealization.blind_iff_below_generator",
      "kind": "theorem",
      "depends_on": [
        "def:NewMathDiscovery.BlindnessRealization"
      ],
      "payload_file": "payloads/NewMathDiscovery_BlindnessRealization_blind_iff_below_generator.theorem.json",
      "solution_file": "Solutions/Sol_NewMathDiscovery_BlindnessRealization_blind_iff_below_generator.lean",
      "theorem_file": "Theorems/Thm_NewMathDiscovery_BlindnessRealization_blind_iff_below_generator.lean",
      "metadata_status": "passed",
      "explanation": "A pair with different targets must consist of the base state and one face state. Equality of their observations at i forces F(j,i)=true, yielding a containing generator. Conversely, a generator containing S makes the base and its face observationally identical on S while their targets differ."
    },
    {
      "key": "thm:NewMathDiscovery.LinearBlindness.RankTwoInstability.distinct_sensor_minor",
      "kind": "theorem",
      "depends_on": [
        "def:NewMathDiscovery.LinearBlindness"
      ],
      "payload_file": "payloads/NewMathDiscovery_LinearBlindness_RankTwoInstability_distinct_sensor_minor.theorem.json",
      "solution_file": "Solutions/Sol_NewMathDiscovery_LinearBlindness_RankTwoInstability_distinct_sensor_minor.lean",
      "theorem_file": "Theorems/Thm_NewMathDiscovery_LinearBlindness_RankTwoInstability_distinct_sensor_minor.lean",
      "metadata_status": "passed",
      "explanation": "After expanding the rows and determinant, the determinant is the integer difference n−m. If this were zero, injectivity of the natural-number cast and integer arithmetic would give m=n, contradicting the hypothesis."
    },
    {
      "key": "thm:NewMathDiscovery.LinearBlindness.RankTwoInstability.tail_witnesses_uniformly_large",
      "kind": "theorem",
      "depends_on": [
        "def:NewMathDiscovery.LinearBlindness"
      ],
      "payload_file": "payloads/NewMathDiscovery_LinearBlindness_RankTwoInstability_tail_witnesses_uniformly_large.theorem.json",
      "solution_file": "Solutions/Sol_NewMathDiscovery_LinearBlindness_RankTwoInstability_tail_witnesses_uniformly_large.lean",
      "theorem_file": "Theorems/Thm_NewMathDiscovery_LinearBlindness_RankTwoInstability_tail_witnesses_uniformly_large.lean",
      "metadata_status": "passed",
      "explanation": "Use the exact kernel identity for the witness with index O+j. Its second coordinate is −1 by definition, and its target O+j+1 is greater than O by natural-number arithmetic."
    },
    {
      "key": "thm:NewMathDiscovery.LinearBlindness.RankTwoInstability.target_nonzero_on_witness",
      "kind": "theorem",
      "depends_on": [
        "def:NewMathDiscovery.LinearBlindness"
      ],
      "payload_file": "payloads/NewMathDiscovery_LinearBlindness_RankTwoInstability_target_nonzero_on_witness.theorem.json",
      "solution_file": "Solutions/Sol_NewMathDiscovery_LinearBlindness_RankTwoInstability_target_nonzero_on_witness.lean",
      "theorem_file": "Theorems/Thm_NewMathDiscovery_LinearBlindness_RankTwoInstability_target_nonzero_on_witness.lean",
      "metadata_status": "passed",
      "explanation": "Expand q and w_n to obtain q(w_n)=n+1 as an integer. This is positive for every natural n, hence nonzero."
    },
    {
      "key": "thm:NewMathDiscovery.LinearBlindness.RankTwoInstability.target_sensor_minor",
      "kind": "theorem",
      "depends_on": [
        "def:NewMathDiscovery.LinearBlindness"
      ],
      "payload_file": "payloads/NewMathDiscovery_LinearBlindness_RankTwoInstability_target_sensor_minor.theorem.json",
      "solution_file": "Solutions/Sol_NewMathDiscovery_LinearBlindness_RankTwoInstability_target_sensor_minor.lean",
      "theorem_file": "Theorems/Thm_NewMathDiscovery_LinearBlindness_RankTwoInstability_target_sensor_minor.lean",
      "metadata_status": "passed",
      "explanation": "Expand the determinant and the row definitions. Multiplication by 0 and 1 reduces the result to the integer cast of n plus one."
    },
    {
      "key": "thm:NewMathDiscovery.LinearBlindness.RankTwoInstability.unbounded_target_on_gauge_fixed_kernel",
      "kind": "theorem",
      "depends_on": [
        "def:NewMathDiscovery.LinearBlindness"
      ],
      "payload_file": "payloads/NewMathDiscovery_LinearBlindness_RankTwoInstability_unbounded_target_on_gauge_fixed_kernel.theorem.json",
      "solution_file": "Solutions/Sol_NewMathDiscovery_LinearBlindness_RankTwoInstability_unbounded_target_on_gauge_fixed_kernel.lean",
      "theorem_file": "Theorems/Thm_NewMathDiscovery_LinearBlindness_RankTwoInstability_unbounded_target_on_gauge_fixed_kernel.lean",
      "metadata_status": "passed",
      "explanation": "Take n=B and d=w_B=(B+1,−1). Substitution makes the observation zero and the second coordinate−1; the target is B+1, which exceeds B."
    },
    {
      "key": "thm:NewMathDiscovery.LinearBlindness.determinesTarget_iff_kernel_inclusion",
      "kind": "theorem",
      "depends_on": [
        "def:NewMathDiscovery.LinearBlindness"
      ],
      "payload_file": "payloads/NewMathDiscovery_LinearBlindness_determinesTarget_iff_kernel_inclusion.theorem.json",
      "solution_file": "Solutions/Sol_NewMathDiscovery_LinearBlindness_determinesTarget_iff_kernel_inclusion.lean",
      "theorem_file": "Theorems/Thm_NewMathDiscovery_LinearBlindness_determinesTarget_iff_kernel_inclusion.lean",
      "metadata_status": "passed",
      "explanation": "If observations determine the target, compare a common-kernel direction with the zero state. Conversely, apply the kernel inclusion to the difference of two states with matching observations. Subtraction preservation and the zero-equality law convert vanishing target difference into equality of targets."
    },
    {
      "key": "thm:NewMathDiscovery.LinearBlindness.pairBlind_downward",
      "kind": "theorem",
      "depends_on": [
        "def:NewMathDiscovery.LinearBlindness"
      ],
      "payload_file": "payloads/NewMathDiscovery_LinearBlindness_pairBlind_downward.theorem.json",
      "solution_file": "Solutions/Sol_NewMathDiscovery_LinearBlindness_pairBlind_downward.lean",
      "theorem_file": "Theorems/Thm_NewMathDiscovery_LinearBlindness_pairBlind_downward.lean",
      "metadata_status": "passed",
      "explanation": "Reuse the same pair of states witnessing blindness for B. Their targets still differ, and each required observation equality for A follows by composing A⊆B with the original agreement hypothesis."
    },
    {
      "key": "thm:NewMathDiscovery.LinearBlindness.pairBlind_iff_kernelWitness",
      "kind": "theorem",
      "depends_on": [
        "def:NewMathDiscovery.LinearBlindness"
      ],
      "payload_file": "payloads/NewMathDiscovery_LinearBlindness_pairBlind_iff_kernelWitness.theorem.json",
      "solution_file": "Solutions/Sol_NewMathDiscovery_LinearBlindness_pairBlind_iff_kernelWitness.lean",
      "theorem_file": "Theorems/Thm_NewMathDiscovery_LinearBlindness_pairBlind_iff_kernelWitness.lean",
      "metadata_status": "passed",
      "explanation": "From an indistinguishable pair use d=x−y. Preservation of subtraction and the zero-equality law show d is in every selected observation kernel while its target is nonzero. Conversely compare a kernel witness d with the distinguished zero state; zero preservation gives the required observation equalities and target difference."
    },
    {
      "key": "thm:NewMathDiscovery.RankedCoalescence.covered_ranked_coalescence_sound",
      "kind": "theorem",
      "depends_on": [
        "def:NewMathDiscovery.RankedCoalescenceSound"
      ],
      "payload_file": "payloads/NewMathDiscovery_RankedCoalescence_covered_ranked_coalescence_sound.theorem.json",
      "solution_file": "Solutions/Sol_NewMathDiscovery_RankedCoalescence_covered_ranked_coalescence_sound.lean",
      "theorem_file": "Theorems/Thm_NewMathDiscovery_RankedCoalescence_covered_ranked_coalescence_sound.lean",
      "metadata_status": "passed",
      "explanation": "First prove by well-founded induction on configurations that every decoded state reaches the fixed terminal. A terminal configuration reaches it in zero steps; otherwise progress selects a lower-ranked edge and induction gives reachability at its target. Exact coalescence transfers that reachability to the source, using that a terminal fixed point remains fixed along every tail. Finally use entry coverage to choose a configuration decoding each domain state."
    }
