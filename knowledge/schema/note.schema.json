{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Sodelin/Collatz-Conjecture-Work/knowledge/schema/note.schema.json",
  "title": "Collatz Work linked research note",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "type",
    "title",
    "status",
    "baseline",
    "created",
    "updated",
    "tags",
    "aliases"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^CW-(CLM|RTE|FLR|SRC|ART|CON|EXP|REL|MOC)-[A-Z0-9-]+$" },
    "type": { "enum": ["claim", "route", "failure", "source", "artifact", "experiment", "release", "concept", "moc"] },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "provisional", "accepted", "rejected", "superseded", "historical"] },
    "proof_status": { "enum": ["open", "provisional", "scoped-proved", "scoped-refuted", "conditional", "equivalent-open", "bounded-only", "archive-status"] },
    "global_effect": { "enum": ["none", "proof", "disproof"] },
    "baseline": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "created": { "type": "string", "format": "date" },
    "updated": { "type": "string", "format": "date" },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "aliases": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "claim_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "route_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "failure_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "rating_c": { "pattern": "^C[0-4]$" },
    "rating_v": { "pattern": "^V[0-4]$" },
    "rating_i": { "pattern": "^I[0-4]$" },
    "rating_n": { "pattern": "^N([0-4]|\\?)$" },
    "rating_r": { "pattern": "^R[0-4]$" }
  },
  "additionalProperties": true
}
